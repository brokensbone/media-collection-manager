# Copy to `.env` for the local deploy. Everything here is optional for the app to *boot* —
# without Spotify credentials it runs fine but shows "reconnect" and the pollers stay paused
# (no data comes in until you connect). Infra wiring (DB URL, beets config path, inbox, static
# dir) is set in docker-compose.yml, not here.

# --- Spotify (§8c) ---------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard and add this exact redirect URI:
#   http://127.0.0.1:8000/auth/spotify/callback
MCM_SPOTIFY_CLIENT_ID=
MCM_SPOTIFY_CLIENT_SECRET=
# Only change if you browse the app on a different host/port than localhost:8000.
MCM_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# --- Optional integrations (leave blank to disable) ------------------------------------
# Transmission auto-land (§12): RPC url enables it; files are pulled via rsync-over-SSH.
MCM_TRANSMISSION_RPC_URL=
MCM_TRANSMISSION_USER=
MCM_TRANSMISSION_PASSWORD=
MCM_TRANSMISSION_SSH_HOST=
MCM_TRANSMISSION_SSH_USER=
MCM_TRANSMISSION_SSH_KEY=

# Watch-dir import (§13): a path *inside the container* to scan for dropped zips/folders.
MCM_WATCHDIR_PATH=

# Notifications (§8d): a Slack-compatible webhook for nudges. Blank = disabled.
MCM_NOTIFICATION_WEBHOOK_URL=
