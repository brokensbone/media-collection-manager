# Real deploy env — copy to `.env` next to docker-compose.prod.yml and fill in every
# CHANGEME. Unlike the local deploy, the paths here are load-bearing: they are both the host
# mount points and what the app/beets use inside the container (same absolute path either side).

# --- Database (on partridge, over the LAN) ---------------------------------------------
# Matches nixos/hosts/partridge/wantlist-db.nix: db `wantlist`, role `wantlist`, reachable on
# the LAN (10.4.1.0/24) only. The password is generated on partridge; read it there with
#   sudo cat /var/lib/postgresql/wantlist-db-password
# Host = partridge's LAN address (its 10.4.1.x IP, or a LAN hostname that resolves to it); the
# app host (blink) must be on that LAN.
WANTLIST_DATABASE_URL=postgresql+psycopg://wantlist:CHANGEME@PARTRIDGE_LAN_HOST:5432/wantlist?sslmode=disable

# --- Beets library (your real, existing one) -------------------------------------------
# WANTLIST_MUSIC_DIR must equal `directory:` in your beets config. WANTLIST_BEETS_DIR is the
# folder holding config.yaml + library.db + the import inbox. Both are bind-mounted at these
# exact paths, so set them to real absolute paths on the app host (blink).
WANTLIST_MUSIC_DIR=/CHANGEME/music
WANTLIST_BEETS_DIR=/CHANGEME/beets
WANTLIST_BEETS_CONFIG=/CHANGEME/beets/config.yaml
WANTLIST_IMPORT_INBOX_PATH=/CHANGEME/beets/inbox

# --- Watch-dir import (§13) ------------------------------------------------------------
# A real absolute path on the host to scan for dropped albums/zips (bind-mounted at this path).
WANTLIST_WATCHDIR_PATH=/CHANGEME/watch

# --- Spotify (§8c) ---------------------------------------------------------------------
# The redirect URI must be the app's real public URL + /auth/spotify/callback, and must be
# added verbatim to the Spotify app at https://developer.spotify.com/dashboard.
WANTLIST_SPOTIFY_CLIENT_ID=CHANGEME
WANTLIST_SPOTIFY_CLIENT_SECRET=CHANGEME
WANTLIST_SPOTIFY_REDIRECT_URI=https://CHANGEME/auth/spotify/callback

# --- Transmission auto-land (§12) — leave blank to disable -----------------------------
# When enabling, also uncomment the SSH key mount in docker-compose.prod.yml, point
# WANTLIST_SSH_KEY at the host key file, and set WANTLIST_TRANSMISSION_SSH_KEY=/keys/id.
WANTLIST_TRANSMISSION_RPC_URL=
WANTLIST_TRANSMISSION_USER=
WANTLIST_TRANSMISSION_PASSWORD=
WANTLIST_TRANSMISSION_SSH_HOST=
WANTLIST_TRANSMISSION_SSH_USER=
WANTLIST_TRANSMISSION_SSH_KEY=
WANTLIST_SSH_KEY=

# --- Notifications (§8d) — Slack-compatible webhook, blank = disabled -------------------
WANTLIST_NOTIFICATION_WEBHOOK_URL=
